# Nginx 主配置模板
# 首次初始化或 reset-config 时由模板生成；生成后的 config 文件由用户维护，启动/重启不会自动覆盖。
# 所有文件系统路径占位符已由 generate_nginx_config 通过 format_nginx_path 统一加双引号包裹，
# 兼容 WNMP 安装到含空格目录（如 D:/Program Files/WNMP）。

worker_processes 1;
error_log {{NGINX_ERROR_LOG}} warn;
pid {{NGINX_PID_PATH}};

events {
    worker_connections 1024;
}

http {
    include       {{NGINX_MIME_TYPES}};
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  {{NGINX_ACCESS_LOG}}  main;

    sendfile        on;
    keepalive_timeout  65;

    client_body_temp_path {{NGINX_CLIENT_BODY_TEMP}};
    proxy_temp_path       {{NGINX_PROXY_TEMP}};
    fastcgi_temp_path     {{NGINX_FASTCGI_TEMP}};
    uwsgi_temp_path       {{NGINX_UWSGI_TEMP}};
    scgi_temp_path        {{NGINX_SCGI_TEMP}};

    # 引入站点配置
    include {{NGINX_SITE_CONF}};

    # 引入用户自定义配置（http 级别）
    include {{NGINX_CUSTOM_HTTP_GLOB}};

    # 引入虚拟主机配置（完整 server 块）
    include {{NGINX_VHOSTS_GLOB}};
}

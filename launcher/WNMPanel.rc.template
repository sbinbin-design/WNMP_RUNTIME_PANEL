/*
 * WNMPanel.rc.template - 资源文件模板（由 sync_version.py 生成 WNMPanel.rc）
 * 引用 UAC manifest 并设置版本信息
 * 注意：使用数值常量以兼容 llvm-rc
 *
 * 版本相关字段使用占位符，由 scripts/sync_version.py 从项目根目录 VERSION 文件读取后替换：
 *   {{FILE_VERSION_COMMA}}   -> FILEVERSION 数字四段，如 0,1,0,0
 *   {{PRODUCT_VERSION_COMMA}} -> PRODUCTVERSION 数字四段，如 0,1,0,0
 *   {{VERSION_STRING}}       -> 完整版本字符串，如 0.1.0-dev
 *
 * 不要直接编辑 WNMPanel.rc，修改本模板或 VERSION 后运行 sync_version.py 即可。
 */

/* 嵌入 UAC manifest */
1 24 "WNMPanel.manifest"

/* 应用图标 */
1 ICON "wnmp-panel.ico"

/* 版本信息 */
1 VERSIONINFO
FILEVERSION     {{FILE_VERSION_COMMA}}
PRODUCTVERSION  {{PRODUCT_VERSION_COMMA}}
FILEFLAGSMASK   0x3F
FILEFLAGS       0
FILEOS          0x40004
FILETYPE        0x1
FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HTTPS://DACAT.CC"
            VALUE "FileDescription",  "WNMP Runtime Panel Launcher"
            VALUE "FileVersion",      "{{VERSION_STRING}}"
            VALUE "InternalName",     "WNMPanel"
            VALUE "LegalCopyright",   "DACAT.CC"
            VALUE "OriginalFilename", "WNMPanel.exe"
            VALUE "ProductName",      "WNMP Runtime"
            VALUE "ProductVersion",   "{{VERSION_STRING}}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
